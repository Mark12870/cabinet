+std::vector<fs::path> get_cabinet_yabridge_directories() {
+    const fs::path installation =
+        "app/io.github.mark12870.cabinet/current/active/files/lib/yabridge";
+
+    std::vector<fs::path> directories;
+    // NOLINTNEXTLINE(concurrency-mt-unsafe)
+    if (const char* home_directory = getenv("HOME")) {
+        directories.push_back(fs::path(home_directory) /
+                              ".local/share/flatpak" / installation);
+    }
+    directories.push_back(fs::path("/var/lib/flatpak") / installation);
+
+    return directories;
+}
