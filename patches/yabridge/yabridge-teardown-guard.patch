diff --git a/src/wine-host/utils.cpp b/src/wine-host/utils.cpp
index 49df194..feb57b1 100644
--- a/src/wine-host/utils.cpp
+++ b/src/wine-host/utils.cpp
@@ -16,6 +16,7 @@
 
 #include "utils.h"
 
+#include <cstring>
 #include <iostream>
 
 #include "bridges/common.h"
@@ -190,3 +191,67 @@ void MainContext::async_handle_watchdog_timer(
         async_handle_watchdog_timer(30s);
     });
 }
+
+#ifdef __x86_64__
+
+namespace {
+
+thread_local CONTEXT* access_violation_recovery = nullptr;
+
+bool inside_native_code(const void* address) {
+    MEMORY_BASIC_INFORMATION region{};
+    if (!VirtualQuery(address, &region, sizeof(region)) ||
+        region.Type != MEM_IMAGE) {
+        return false;
+    }
+
+    constexpr char builtin_signature[] = "Wine builtin DLL";
+    return memcmp(static_cast<const char*>(region.AllocationBase) + 0x40,
+                  builtin_signature, sizeof(builtin_signature) - 1) != 0;
+}
+
+LONG CALLBACK recover_from_access_violation(EXCEPTION_POINTERS* exception) {
+    if (!access_violation_recovery ||
+        exception->ExceptionRecord->ExceptionCode !=
+            EXCEPTION_ACCESS_VIOLATION ||
+        !inside_native_code(exception->ExceptionRecord->ExceptionAddress)) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+
+    *exception->ContextRecord = *access_violation_recovery;
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+}
+
+void survive_access_violation(fu2::unique_function<void()> teardown) {
+    static const PVOID handler =
+        AddVectoredExceptionHandler(1, recover_from_access_violation);
+    (void)handler;
+
+    CONTEXT* const outer = access_violation_recovery;
+    CONTEXT context{};
+    volatile bool armed = false;
+
+    RtlCaptureContext(&context);
+    if (armed) {
+        access_violation_recovery = outer;
+        std::cerr << "The plugin crashed while being torn down; its remains "
+                     "are left in memory."
+                  << std::endl;
+        return;
+    }
+
+    armed = true;
+    access_violation_recovery = &context;
+    teardown();
+    access_violation_recovery = outer;
+}
+
+#else
+
+void survive_access_violation(fu2::unique_function<void()> teardown) {
+    teardown();
+}
+
+#endif
