     /**
      * Message to pass through a call to
      * `{IComponent,IEditController}::setState(state)` to the Wine plugin host.
+     * `edit_controller` says which of the two the host called, since a plugin
+     * object can implement both with different meanings.
      */
     struct SetState {
         using Response = UniversalTResult;
 
         native_size_t instance_id;
+        bool edit_controller;
 
         YaBStream state;
 
         template <typename S>
         void serialize(S& s) {
             s.value8b(instance_id);
+            s.value1b(edit_controller);
             s.object(state);
         }
     };
@@ -321,17 +325,20 @@ class Vst3PluginProxy : public YaAudioPresentationLatency,
     /**
      * Message to pass through a call to
      * `{IComponent,IEditController}::getState(&state)` to the Wine plugin host.
+     * `edit_controller` says which of the two the host called.
      */
     struct GetState {
         using Response = GetStateResponse;
 
         native_size_t instance_id;
+        bool edit_controller;
 
         YaBStream state;
 
         template <typename S>
         void serialize(S& s) {
             s.value8b(instance_id);
+            s.value1b(edit_controller);
