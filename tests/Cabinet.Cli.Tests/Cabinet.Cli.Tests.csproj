<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Cabinet.Core.Tests/Repo.cs" Link="Repo.cs" />
    <Compile Include="../Cabinet.Core.Tests/RecordingRunner.cs" Link="RecordingRunner.cs" />
    <Compile Include="../Cabinet.Core.Tests/SessionFiles.cs" Link="SessionFiles.cs" />
    <Compile Include="../Cabinet.Core.Tests/TestRoot.cs" Link="TestRoot.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cabinet.Cli/Cabinet.Cli.csproj" />
  </ItemGroup>

</Project>
