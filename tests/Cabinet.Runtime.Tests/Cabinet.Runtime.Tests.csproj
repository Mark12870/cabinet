<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Probes/**" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Cabinet.Core.Tests/Repo.cs" Link="Repo.cs" />
    <Compile Include="../Cabinet.Core.Tests/UnusedRunner.cs" Link="UnusedRunner.cs" />
    <Compile Include="../Cabinet.Core.Tests/SessionFiles.cs" Link="SessionFiles.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cabinet.Core/Cabinet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.Retry" Version="2.4.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
