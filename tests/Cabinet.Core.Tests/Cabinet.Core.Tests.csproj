<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/Cabinet.Gui/RefreshGeneration.cs" Link="RefreshGeneration.cs" />
    <Compile Include="../../tools/Cabinet.Ci/ScenarioReport.cs" Link="ScenarioReport.cs" />
    <Compile Include="../../tools/Cabinet.Ci/Scenarios.cs" Link="Scenarios.cs" />
    <Compile Include="../../tools/Cabinet.Ci/CatalogueUpdateConfiguration.cs" Link="CatalogueUpdateConfiguration.cs" />
    <Compile Include="../../tools/Cabinet.Ci/CatalogueUpdateCoverage.cs" Link="CatalogueUpdateCoverage.cs" />
    <Compile Include="../../tools/Cabinet.Ci/CatalogueRelease.cs" Link="CatalogueRelease.cs" />
    <Compile Include="../../tools/Cabinet.Ci/CatalogueUpdateService.cs" Link="CatalogueUpdateService.cs" />
    <Compile Include="../Cabinet.Runtime.Tests/Scenarios/Credentials.cs" Link="Credentials.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cabinet.Core/Cabinet.Core.csproj" />
    <ProjectReference Include="../Cabinet.Testing/Cabinet.Testing.csproj" />
  </ItemGroup>

</Project>
